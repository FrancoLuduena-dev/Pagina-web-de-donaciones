{
  "entryPoints": [
    "./app",
    "./components",
    "./constants",
    "./lib",
    "./types"
  ],
  "entryPointStrategy": "expand",
  "out": "./docs",
  "validation": {
    "notDocumented": false,
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/node_modules/**",
    "**/.next/**"
  ],
  "skipErrorChecking": true
}