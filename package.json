{
  "name": "pagina-de-donaciones",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:front": "npm run dev -w frontend",
    "dev:back": "npm run start:dev -w backend",
    "dev": "concurrently \"npm run dev -w frontend\" \"npm run start:dev -w backend\"",
    "setup-db": "npm run setup-db -w backend",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:all": "npm run test:frontend && npm run test:backend",

    "test:frontend:watch": "npm --prefix frontend run test:watch",
    "test:backend:watch": "npm --prefix backend run test:watch",

    "test:frontend:cov": "npm --prefix frontend run test:cov",
    "test:backend:cov": "npm --prefix backend run test:cov",
    "test:all:coverage": "npm run test:frontend:coverage && npm run test:backend:coverage"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "jest": "^30.4.2"
  }
}
