+listarMisPublicaciones(creadorId: string, estado?: EstadoPublicacion): Promise<Publicacion[]>
+editar(id: string, dto: EditarPublicacionDto, usuarioId: string): Promise<Publicacion>
+buscarPublicacionPorId(id: string): Promise<Publicacion>
+buscarPublicacionPorIdConCreador(id: string): Promise<PublicacionConCreador>
+reservar(id: string, usuarioId: string): Promise<Publicacion>
+cancelarReserva(id: string, usuarioId: string): Promise<Publicacion>
+pausar(id: string, usuarioId: string, usuarioRol: rolUsuario): Promise<Publicacion>
+reactivar(id: string, usuarioId: string, usuarioRol: rolUsuario): Promise<Publicacion>
