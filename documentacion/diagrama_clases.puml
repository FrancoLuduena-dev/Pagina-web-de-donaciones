'-- ENUMS -- 
    '--- ENUMS Usuario --- 

enum RolUsuario <<enum>>{
    COMUN
    MODERADOR
    ADMIN
}

enum EstadoCuenta <<enum>>{
    ACTIVA
    BLOQUEADA
}

    '--- ENUMS Publicacion ---

enum CategoriaPublicacion <<enum>>{
    INDUMENTARIA
    MUEBLES
    ALIMENTOS
    OTROS
}

enum TipoEntrega <<enum>>{
    RETIRO
    ENTREGA
    RETIRO_O_ENTREGA
}

enum EstadoPublicacion <<enum>>{
    DISPONIBLE
    RESERVADO
    ENTREGADO
    PAUSADO
    ELIMINADO
}

enum EstadoDonacion <<enum>>{
    NUEVO
    USADO
}

    ' --- ENUMS Solicitud ---

enum EstadoSolicitud <<enum>>{
    PENDIENTE
    ACEPTADA
    RECHAZADA
}
    ' --- ENUMS Denuncia ---
enum EstadoDenuncia <<enum>>{
    PENDIENTE
    EN_REVISION
    RESUELTA
}

' --- Uso de DTOs en Services ---

UsuarioService ..> CrearUsuarioDto : usa
UsuarioService ..> ActualizarPerfilDto : usa
UsuarioService ..> ActualizarPasswordDto : usa

PublicacionService ..> CrearPublicacionDto : usa
PublicacionService ...> EditarPublicacionDto : usa
PublicacionService ..> EliminarPublicacionDto : usa
PublicacionService ...> ActivarPublicacionDto : usa
PublicacionService ..> CancelarPublicacionDto : usa
PublicacionService ...> FinalizarPublicacionDto : usa
PublicacionService ..> PausarPublicacionDto : usa
PublicacionService ...> ReservarPublicacionDto : usa
PublicacionService ..> DenunciarPublicacionDto : usa
PublicacionService ...> BloquearPublicacionDto : usa

SolicitudService ..> SolicitudResponseDto : usa
SolicitudService ..> CrearSolicitudDto: usa
SolicitudService ..> AceptarSolicitudDTO: usa
SolicitudService ..> RechazarSolicitudDto: usa
SolicitudService ..> CancelarSolicitudDto: usa

' --- Gestión de Entidades ---
UsuarioService -u-> Usuario : gestiona >
PublicacionService --> Publicacion : gestiona >
SolicitudService --> Solicitud : gestiona >
DenunciaService -u-> Denuncia : gestiona >

' --- Conexiones de Asociación (Lógica de Negocio) ---
Usuario "1" -- "*" Publicacion : crea >
Usuario "1" -- "*" Solicitud : realiza >
Usuario "1" -- "*" Denuncia : reporta >

Publicacion "1" ---- "*" Solicitud : recibe >
Publicacion "1" ---- "*" Denuncia : tiene >

' --- Relaciones con Enums ---
Usuario --> RolUsuario
Usuario --> EstadoCuenta
Publicacion --> CategoriaPublicacion
Publicacion --> TipoEntrega
Publicacion --> EstadoPublicacion
Publicacion --> EstadoDonacion
Solicitud---> EstadoSolicitud
Denuncia -r-> EstadoDenuncia

' --- Otros ---
Buscador .u....> Publicacion : busca en >
Estadisticas .u....> Usuario : trackea >
Estadisticas .u....> Publicacion : trackea >


' --- Diseño ---
skinparam roundcorner 20
skinparam classFontColor automatic

' -- Colores de Clases y Entidades --
skinparam class {
    BackgroundColor #TECHNOLOGY
    HeaderBackgroundColor #444
    BorderColor #333
}

skinparam class<<enum>> {
    BackgroundColor #LightSalmon
    HeaderBackgroundColor #444
    BorderColor #333
}

skinparam class<<DTO>>{
    BackgroundColor #lightblue
    HeaderBackgroundColor #444
    BorderColor #333
}




@enduml

