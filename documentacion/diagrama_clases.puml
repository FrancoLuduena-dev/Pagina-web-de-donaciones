+cancelarReservaPorPublicacion(publicacionId: string, usuarioId: string, motivo?: string): Promise<SolicitudResponseDto>
+cancelarSolicitud(solicitudId: string, usuarioId: string, motivo?: string): Promise<SolicitudResponseDto>
+resolverSolicitudesPorPublicacionEliminada(publicacionId: string): Promise<void>
}

class DenunciaService {
