@startuml Web Donaciones
'left to right direction


class Usuario {
    - idUsuario: UUID
    - nombreCompleto: string
    - nombreUsuario: string
    - email: string
    - password: hash
    - numeroTelefono: string
    - rolUsuario: string
    - estadoCuenta: EstadoCuenta
    .. Solo moderadores ..
    - cantidadPublicacionesBloqueadas: int
    - razonBloqueo: string
    - idBloqueador: UUID
    + getters()
    + setters()
}
'(rol: moderador, admin, normal) (estado: activo, bloqueado) (id es la key)
'id no tiene setter
'lios setters y getters solo se consumen en dto y services

class UsuarioService {
    .. Usuarios ..
    + crearUsuario (datos: CrearUsuarioDTO)
    + eliminarUsuario (user: idUsuario)
    + resetearPasswordUsuario (user: idUsuario, datos: ActualizarPasswordDto)
    + actualizarPerfil (user: idUsuario, datos: ActualizarPerfilDto)
    .. Solo moderadores ..
    + listarUsuarios()
    + cambiarRolUsuario (user: usuario, id: idUsuario, rolNuevo: RolUsuario)
    + bloquearUsuarios (user: idUsuario, mod:idUsuario)
}
'el bloqueo de usuariose hace automatico cuando tiene 3 publicaciones bloqueadas

class Publicacion {
    - idPublicacion: UUID
    - idCreador: UUID
    - tituloPublicacion: string
    - descripcionPublicacion: string
    - urlFoto: string
    - categoria: CategoriaPublicacion
    - zonaRetiro: string
    - entrega: TipoEntrega
    - estadoPublicacion: EstadoPublicacion
    - estadoDonacion: estadoDonacion
    - idBloqueador: UUID
    - motivoBloqueo: string
    + setters()
    + getters()
}

class PublicacionService {
    + crearPublicacion (user: usuario, datos: CrearPublicacionDto)
    + abrirPublicacion (user: usuario, id: idPublicacion)
    .. solo creador de publicacion ..
    + editarPublicacion (user: usuario, id: idPublicacion, datos: EditarPublicacionDto)
    + activarPublicacion (user: usuario, id: idPublicacion, datos: ActivarPublicacionDto)
    + cancelarPublicacion (user: usuario, id: idPublicacion, datos: CancelarPublicacionDto)
    + finalizarPublicacion (user: usuario, id: idPublicacion, datos: FinalizarPublicacionDto)
    + pausarPublicacion (user: usuario, id: idPublicacion, datos: PausarPublicacionDto)
    + reservarPublicacion (user: usuario, id: idPublicacion, datos: ReservarPublicacionDto)
    + eliminarPublicacion (user: usuario, id: idPublicacion, datos: EliminarPublicacionDto)
    .. Todos los usuarios ..
    .. Solo Usuarios no creadores de la publicacion ..
    + denunciarPublicacion (user: usuario, id: idPublicacion, datos: DenunciarPublicacionDto)
    .. Solo moderadores..
    + bloquearPublicacion (user: usuario, id: idPublicacion, datos: BloquearPublicacionDto)

}
' para mi, pausarPublicacion, activarPublicacion, cancelarPublicacion, reservarPublicacion y finalizarPublicacion deberian condensarse en una sola cambiarEstadoPublicacion() porque todos los dtos son iguales, y todos estos metodos harian lo mismo, cambiar el publicacion.estadoPublicacion a otro parametro del enum

class Solicitud{
    - idSolicitud: UUID
    - idSolicitante: UUID
    - idPublicacionSolicitada: UUID
    - idCreadorPublicacion: UUID
    - estadoSolicitud: EstadoSolicitud
    - datosSolicitud: string
}

class SolicitudService {
    + crearSolicitud ( user: usuario, id: idPublicacionSolicitada, datos: crearSolicitudDto, SolicitudResponseDto)
    + cancelarSolicitud (user: usuario, id: idSolicitud, datos: cancelarSolicitudDto, SolicitudResponseDto)
    + listarSolicitudesPendientesPorUsuario (user: usuario, datos: SolicitudResponseDto)
    + listarSolicitudesRecibidasPorUsuario (solicita: usuario, datos: SolicitudResponseDto)
    + listarSolicitudesRealizadasPorUsuario (user: usuario, datos: SolicitudResponseDto)
    .. Solo creador publicacion..
    + listarSolicitudesPorPublicacion (user: usuario, idPublicacion, datos: SolicitudResponseDto)
    ..Solo creador publicacion..
    + aceptarSolicitud (user: usuario, id: idPublicacion, datos: AceptarSolicitudDTO, SolicitudResponseDto)
    ' al ser aceptada, rechaza todas las otras solicitudes pendientes automaticamente
    + rechazarSolicitud (user: usuario, id: idPublicacion, datos: RechazarSolicitudDto, SolicitudResponseDto)
}

class Denuncia {
    - idDenuncia: UUID
    - idPublicacion : UUID
    - idUsuario: UUID
    - estadoDenuncia: EstadoDenuncia
}

class DenunciaService {
    - crearDenuncia(usuario: idUsuario, publicacion: idPublicacion)
    .. Solo Moderadores ..
    - resolverDenuncia( denuncia: idDenuncia, publicacion: id.publicacion, estado: estadoDenuncia)
    - ListarDenuncias()
}

class Buscador{
    + busquedaCategoria (publicacion: publicacion[], categoria: CategoriPublicacion)
    + busquedaNombre (publicacion: publicacion[], nombre: string)
    + busquedaEstadoPublicacion (publicacion: publicacion[], estado: EstadoPublicacion)
    + busquedaEntrega (publicacion: publicacion[], entrega: TipoEntrega)
}

class Estadisticas {
    logCantidadDonaciones
    logSolicitudes
    logPorcentajeEntregado
    logPorcentajeCategoria
    logCrearUsuario
    logCantidadPublicacionesActivas
    logCantidadUsuariosBloqueados
    logCantidadPublicacionesBloqueadas
}
'todavia no estoy seguro si estos logs no deberia ser una clase log, con diferentes datos, y con atributos, opcionales, que pueda dar esta info.

