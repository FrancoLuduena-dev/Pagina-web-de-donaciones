package "Servicios" {

class UsuarioService {
+CrearUsuario(usuario: CrearUsuarioDTO): Promise<Usuario>
+EliminarUsuario(idUsuario: string, contrasenia: string): Promise<void>
+EliminarUsuarioAdmin(idUsuario: string, idAdmin: string): Promise<void>
+ActualizarUsuario(idUsuario: string, datos: actualizarUsuarioDTO): Promise<void>
+obtenerUsuarioPorId(idUsuario: string): Promise<Usuario>
+ObtenerUsuarioPorNombreUsuario(nombreUsuario: string): Promise<Usuario | null>
+ObtenerUsuarioPorCorreo(correo: string): Promise<Usuario | null>
+CambiarRolUsuario(idUsuario: string, idAdmin: string, datos: CambiarRolDTO): Promise<void>
+registrarPublicacionEliminadaPorModeracion(idUsuario: string, idModerador: string): Promise<void>
+ResetearContraseniaUsuario(idUsuario: string, dto: actualizarContraseniaDTO): Promise<void>
+BloquearUsuario(idUsuario: string, idModerador: string, datos: BloquearUsuarioDTO): Promise<void>
