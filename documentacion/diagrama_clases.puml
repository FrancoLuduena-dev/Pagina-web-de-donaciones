package "Enums" {

enum rolUsuario {
usuarioModerador
usuarioNormal
usuarioAdministrador
}

enum estadosUsuario {
ACTIVO
BLOQUEADO
}

enum EstadoPublicacion {
DISPONIBLE
RESERVADA
ENTREGADA
PAUSADA
ELIMINADA
}

enum CondicionObjeto {
NUEVO
USADO_BUENO
USADO_REGULAR
}

enum EstadoSolicitud {
PENDIENTE
ACEPTADA
RECHAZADA
CANCELADA
FINALIZADA
EXPIRADA
}

enum MotivoDenuncia {
CONTENIDO_INAPROPIADO
PUBLICACION_FALSA
OBJETO_PROHIBIDO
OTRO
}

enum EstadoDenuncia {
PENDIENTE
EN_REVISION
RESUELTA
}

enum TipoResolucion {
DESCARTADA
PUBLICACION_PAUSADA
PUBLICACION_ELIMINADA
USUARIO_BLOQUEADO
}

enum TipoNotificacion {
SOLICITUD_CREADA
SOLICITUD_ACEPTADA
SOLICITUD_RECHAZADA
SOLICITUD_ACEPTADA_CANCELADA
SOLICITUD_FINALIZADA
DENUNCIA_RESUELTA
PUBLICACION_PAUSADA
PUBLICACION_REACTIVADA
PUBLICACION_ELIMINADA
USUARIO_BLOQUEADO
}
}

' Relaciones entre entidades
Usuario "0..1" -- "0..*" Usuario : bloqueador / bloqueados

Usuario "1" ..> "0..*" Publicacion : creadorId
Publicacion "1" -- "0..*" Solicitud : solicitudes

Usuario "1" -- "0..*" Solicitud : solicitante
Usuario "1" -- "0..*" Solicitud : creadorPublicacion

Publicacion "1" ..> "0..*" Denuncia : publicacionId
Usuario "1" ..> "0..*" Denuncia : denuncianteId
Usuario "1" ..> "0..*" Denuncia : creadorPublicacionId
Usuario "0..1" ..> "0..*" Denuncia : moderadorAsignadoId

Usuario "1" -- "0..*" Notificacion : destinatario
Solicitud "0..1" -- "0..*" Notificacion : solicitud
Publicacion "0..1" -- "0..*" Notificacion : publicacion
Denuncia "0..1" -- "0..*" Notificacion : denuncia

' Dependencias controller -> service
UsuarioController ..> UsuarioService
PublicacionController ..> PublicacionService
SolicitudController ..> SolicitudService
DenunciaController ..> DenunciaService
NotificacionController ..> NotificacionService

' Dependencias principales entre servicios
PublicacionService ..> UsuarioService : consulta creador / bloqueo automático
SolicitudService ..> PublicacionService : reserva / entrega / cancelación
DenunciaService ..> PublicacionService : pausa o elimina publicación
DenunciaService ..> UsuarioService : bloquea usuario

' Uso de DTOs
PublicacionService ..> CrearPublicacionDto
PublicacionService ..> EditarPublicacionDto
SolicitudService ..> CrearSolicitudDto
SolicitudService ..> RechazarSolicitudDto
SolicitudService ..> SolicitudResponseDto
DenunciaService ..> CrearDenunciaDto
DenunciaService ..> ResolverDenunciaDto
DenunciaService ..> DenunciaResponseDto
DenunciaService ..> DenunciaDetalleResponseDto
NotificacionService ..> CrearNotificacionDto
NotificacionService ..> NotificacionResponseDto
UsuarioService ..> CrearUsuarioDTO
UsuarioService ..> BloquearUsuarioDTO
@enduml
