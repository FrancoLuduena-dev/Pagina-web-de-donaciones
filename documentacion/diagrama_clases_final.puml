@startuml
' Diagrama de clases simplificado generado desde backend
package "Entidades" {
  class Usuario {
    +id: uuid
    +nombreCompleto: string
    +nombreUsuario: string
    +correo: string
    -contrasenia: string
    +numeroTelefono: string
    +rol: rolUsuario
    +estado: estadosUsuario
    +creadoEn: Date
    +actualizadoEn: Date
  }

  class Publicacion {
    +id: uuid
    +creadorId: uuid
    +titulo: string
    +descripcion: text
    +categoriaId: uuid
    +localidadId: uuid
    +condicion: CondicionObjeto
    +imagenUrls: string[]
    +estado: EstadoPublicacion
    +version: int
    +createdAt: Date
    +updatedAt: Date
    +deletedAt: Date
  }

  class Solicitud {
    +id: uuid
    +publicacionId: uuid
    +solicitanteId: uuid
    +creadorPublicacionId: uuid
    +mensaje: string
    +estado: EstadoSolicitud
    +version: int
    +createdAt: Date
    +updatedAt: Date
  }

  class Denuncia {
    +id: uuid
    +publicacionId: uuid
    +denuncianteId: uuid
    +creadorPublicacionId: uuid
    +motivo: MotivoDenuncia
    +comentario?: string
    +estado: EstadoDenuncia
    +moderadorAsignadoId?: uuid
    +tipoResolucion?: TipoResolucion
    +detalleResolucion?: string
    +fechaResolucion?: Date
    +version: int
    +fechaCreacion: Date
    +fechaActualizacion: Date
    +tomar(moderadorId: string)
    +resolver(moderadorId: string, tipoResolucion: TipoResolucion, detalle: string)
  }

  class Notificacion {
    +id: uuid
    +destinatarioId: uuid
    +tipo: TipoNotificacion
    +titulo: string
    +mensaje: text
    +leidaEn?: Date
    +solicitudId?: uuid
    +publicacionId?: uuid
    +denunciaId?: uuid
    +creadaEn: Date
    +marcarComoLeida()
  }
}

package "Servicios / Controllers" {
  class DenunciaController {
    +resolverDenuncia(req, id, dto)
    +tomarDenuncia(...)
  }

  class DenunciaService {
    +crearDenuncia(...)
    +listar(...)
    +buscarDetallePorId(...)
    +tomarDenuncia(...)
    +resolverDenuncia(denunciaId, moderadorId, dto)
    -ejecutarAccionResolucion(...)
  }

  class PublicacionService {
    +buscarPublicacionPorId(id)
    +pausar(...)
    +eliminar(...)
    +otrasOperaciones(...)
  }

  class UsuarioService {
    +BloquearUsuario(usuarioId, moderadorId, datos)
    +otrasOperaciones(...)
  }
}

' Enums principales
package "Enums" {
  enum rolUsuario {
    usuarioModerador
    usuarioNormal
    usuarioAdministrador
  }

  enum estadosUsuario {
    ACTIVO
    BLOQUEADO
  }

  enum EstadoPublicacion {
    DISPONIBLE
    RESERVADA
    ENTREGADA
    PAUSADA
    ELIMINADA
  }

  enum CondicionObjeto {
    NUEVO
    USADO_BUENO
    USADO_REGULAR
  }

  enum EstadoSolicitud {
    PENDIENTE
    ACEPTADA
    RECHAZADA
    CANCELADA
    FINALIZADA
    EXPIRADA
  }

  enum MotivoDenuncia {
    CONTENIDO_INAPROPIADO
    PUBLICACION_FALSA
    OBJETO_PROHIBIDO
    OTRO
  }

  enum EstadoDenuncia {
    PENDIENTE
    EN_REVISION
    RESUELTA
  }

  enum TipoResolucion {
    DESCARTADA
    PUBLICACION_PAUSADA
    PUBLICACION_ELIMINADA
    USUARIO_BLOQUEADO
  }

  enum TipoNotificacion {
    SOLICITUD_CREADA
    SOLICITUD_ACEPTADA
    SOLICITUD_RECHAZADA
    SOLICITUD_ACEPTADA_CANCELADA
    SOLICITUD_FINALIZADA
    DENUNCIA_RESUELTA
    PUBLICACION_PAUSADA
    PUBLICACION_REACTIVADA
    PUBLICACION_ELIMINADA
    USUARIO_BLOQUEADO
  }
}

package "DTOs" {
  class ResolverDenunciaDto {
    +version: int
    +tipoResolucion: TipoResolucion
    +detalleResolucion: string
  }

  class CrearDenunciaDto {
    +publicacionId: uuid
    +motivo: MotivoDenuncia
    +comentario?: string
  }

  class DenunciaResponseDto {
    +id: uuid
    +publicacionId: uuid
    +denuncianteId: uuid
    +creadorPublicacionId: uuid
    +moderadorAsignadoId?: uuid
    +motivo: MotivoDenuncia
    +comentario?: string
    +estado: EstadoDenuncia
    +tipoResolucion?: TipoResolucion
    +fechaCreacion: Date
    +fechaActualizacion: Date
    +version: int
  }

  class DenunciaDetalleResponseDto {
    +id: uuid
    +publicacionId: uuid
    +denuncianteId: uuid
    +creadorPublicacionId: uuid
    +moderadorAsignadoId?: uuid
    +motivo: MotivoDenuncia
    +comentario?: string
    +estado: EstadoDenuncia
    +tipoResolucion?: TipoResolucion
    +detalleResolucion?: string
    +fechaResolucion?: Date
    +fechaCreacion: Date
    +fechaActualizacion: Date
    +version: int
  }

  class SolicitudResponseDto {
    +id: uuid
    +publicacionId: uuid
    +solicitanteId: uuid
    +creadorPublicacionId: uuid
    +estado: EstadoSolicitud
    +mensaje: string|null
    +motivoRechazo: string|null
    +motivoCancelacion: string|null
    +createdAt: Date
    +updatedAt: Date
    +publicacion?: { id: string, titulo: string }
    +solicitante?: { id: string, nombre: string, email?: string, telefono?: string }
    +creadorPublicacion?: { id: string, nombre: string, email?: string, telefono?: string }
  }

  class CrearSolicitudDto {
    +publicacionId: uuid
    +mensaje?: string
  }

  class RechazarSolicitudDto {
    +motivo?: string
  }

  class PublicacionResponseDto {
    +id: uuid
    +titulo: string
    +descripcion: string
    +categoriaId: uuid
    +localidadId: uuid
    +condicion: string
    +imagenUrls: string[]
    +estado: string
    +creadorId: uuid
    +creadorNombreUsuario: string
    +creadorNombreCompleto: string
    +createdAt: Date
  }

  class UsuarioResponseDto {
    +id: uuid
    +nombreUsuario: string
    +nombreCompleto: string
  }

  class NotificacionResponseDto {
    +id: uuid
    +tipo: TipoNotificacion
    +titulo: string
    +mensaje: string
    +leida: boolean
    +leidaEn: Date|null
    +solicitudId: uuid|null
    +publicacionId: uuid|null
    +denunciaId: uuid|null
    +creadaEn: Date
  }
}

' Relaciones (basadas en FK en entities)
Usuario "1" -- "*" Publicacion : crea >
Usuario "1" -- "*" Solicitud : solicita >
Usuario "1" -- "*" Denuncia : denuncia >
Usuario "1" -- "*" Notificacion : recibe >
Publicacion "1" -- "*" Solicitud : tiene >
Publicacion "1" -- "*" Denuncia : referenciada por >
Denuncia "*" --> "1" Publicacion : publicacionId >
Solicitud "*" --> "1" Publicacion : publicacionId >
Notificacion "*" --> "1" Usuario : destinatarioId >

' Notificacion puede referenciar opcionalmente otras entidades
Notificacion "*" --> "0..1" Solicitud : solicitudId
Notificacion "*" --> "0..1" Publicacion : publicacionId
Notificacion "*" --> "0..1" Denuncia : denunciaId

@enduml
